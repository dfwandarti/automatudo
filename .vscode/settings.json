{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestArgs": [
        "features"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "gs-behave-bdd.importStrategy": "fromEnvironment",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.inlayHints.variableTypes": false,
    "python.analysis.inlayHints.functionReturnTypes": false,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportUnknownVariableType": "none",
        "reportUnknownMemberType": "none",
        "reportUnknownArgumentType": "none",
        "reportUnknownParameterType": "none",
        "reportOptionalMemberAccess": "warning",
        "reportGeneralTypeIssues": "warning"
    },
    "gs-behave-bdd.completedMigrations": [
        "projectPath-from-behavevsc",
        "runParallel-from-behavevsc",
        "justMyCode-from-behavevsc",
        "xRay-from-behavevsc",
        "verboseLogging-from-behavevsc",
        "multiRootRunWorkspacesInParallel-from-behavevsc",
        "importStrategy-from-behavevsc",
        "stepDefinitionSearchTimeout-from-behavevsc",
        "discoveryDepth-from-behavevsc",
        "discoveryStopOnFirstHit-from-behavevsc",
        "activeEnvVarPreset-from-behavevsc",
        "featuresPath-self",
        "featuresPath-from-behavevsc",
        "suppressMultiConfig-self",
        "suppressedNotifications-from-behavevsc",
        "envVarPresets-from-behavevsc",
        "envVarOverrides-from-behavevsc"
    ]
}